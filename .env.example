# ============================================================
# Ibrat — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================================

# === General ===
PROJECT_NAME=ibrat
ENVIRONMENT=development
DEBUG=true

# === JWT ===
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ibrat
POSTGRES_PASSWORD=ibrat_dev_password
POSTGRES_DB=ibrat

# Service-specific database names
USER_DB_NAME=user_db
PRODUCT_DB_NAME=product_db
CART_DB_NAME=cart_db
INVENTORY_DB_NAME=inventory_db

# Database URLs (used by services)
USER_DB_URL=postgresql+asyncpg://ibrat:ibrat_dev_password@postgres:5432/user_db
PRODUCT_DB_URL=postgresql+asyncpg://ibrat:ibrat_dev_password@postgres:5432/product_db
CART_DB_URL=postgresql+asyncpg://ibrat:ibrat_dev_password@postgres:5432/cart_db
INVENTORY_DB_URL=postgresql+asyncpg://ibrat:ibrat_dev_password@postgres:5432/inventory_db

# Sync URLs (for Alembic)
USER_DB_URL_SYNC=postgresql://ibrat:ibrat_dev_password@postgres:5432/user_db
PRODUCT_DB_URL_SYNC=postgresql://ibrat:ibrat_dev_password@postgres:5432/product_db
CART_DB_URL_SYNC=postgresql://ibrat:ibrat_dev_password@postgres:5432/cart_db
INVENTORY_DB_URL_SYNC=postgresql://ibrat:ibrat_dev_password@postgres:5432/inventory_db

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# === Elasticsearch ===
ELASTICSEARCH_URL=http://elasticsearch:9200

# === Service URLs (internal) ===
USER_SERVICE_URL=http://user-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
SEARCH_SERVICE_URL=http://search-service:8003
CART_SERVICE_URL=http://cart-service:8004
INVENTORY_SERVICE_URL=http://inventory-service:8005

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SITE_NAME=Ibrat

# === Image Upload ===
MAX_IMAGE_SIZE_MB=5
UPLOAD_DIR=/app/uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# === Admin ===
ADMIN_EMAIL=admin@ibrat.com
ADMIN_PASSWORD=Admin@12345
